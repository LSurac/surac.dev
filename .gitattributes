# LF in the repository, native line endings on checkout.
* text=auto eol=lf

*.cs text
*.csproj text
*.slnx text
*.json text
*.md text
*.ts text
*.html text
*.scss text
*.yml text
*.yaml text
*.sh text eol=lf

# Windows-oriented scripts stay CRLF
*.ps1 text eol=crlf

# Binary assets
*.woff2 binary
*.png binary
*.jpg binary
*.ico binary
