<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 test projects are executables. The mtp-off package keeps dotnet test on VSTest, so the
         gate commands in docs/build-and-test.md and CI stay as they are. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 wants TestContext.Current.CancellationToken passed to every awaited call so an aborted
         run stops sooner; the suite runs in about a minute, so the mechanical edits would buy nothing. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    Coverage gate (docs/testing.md): `dotnet test -p:CollectCoverage=true` applies these defaults, so the
    threshold is the same on a workstation and in CI. Migrations are generated code and excluded.
  -->
  <PropertyGroup>
    <Threshold>85</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <Exclude>[SuracDev.Api]SuracDev.Api.Data.Migrations.*</Exclude>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)TestResults/coverage/</CoverletOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuracDev.Api\SuracDev.Api.csproj" />
  </ItemGroup>

</Project>
