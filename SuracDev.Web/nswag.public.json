{
  "runtime": "Net100",
  "defaultVariables": "OutputDir=src/app/api/generated",
  "documentGenerator": {
    "aspNetCoreToOpenApi": {
      "project": "../SuracDev.Api/SuracDev.Api.csproj",
      "configuration": "Debug",
      "targetFramework": "net10.0",
      "noBuild": true,
      "aspNetCoreEnvironment": "OpenApi",
      "documentName": "public",
      "output": "$(OutputDir)/public.openapi.json",
      "msBuildOutputPath": "../SuracDev.Api/bin/Debug/net10.0/"
    }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "className": "{controller}Client",
      "template": "Angular",
      "httpClass": "HttpClient",
      "injectionTokenType": "InjectionToken",
      "rxJsVersion": 7.8,
      "dateTimeType": "string",
      "generateClientClasses": true,
      "generateClientInterfaces": false,
      "generateDtoTypes": true,
      "generateOptionalParameters": true,
      "useSingletonProvider": true,
      "typeStyle": "Interface",
      "enumStyle": "StringLiteral",
      "nullValue": "Undefined",
      "output": "$(OutputDir)/public.client.ts"
    }
  }
}
