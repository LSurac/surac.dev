{
  "name": "surac-dev-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node dist/surac-dev/server/server.mjs",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "lint": "eslint src e2e scripts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "api:build": "dotnet build ../SuracDev.Api/SuracDev.Api.csproj --configuration Debug",
    "api:generate": "npm run api:build && nswag run nswag.public.json && nswag run nswag.admin.json && prettier --write \"src/app/api/generated/*.ts\"",
    "contract:check": "node scripts/check-api-contract.mjs",
    "e2e": "pwsh -NoProfile -File e2e/run-e2e.ps1"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/ssr": "22.2.6",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "~26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "nswag": "14.7.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
