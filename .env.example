# Copy to .env on the host and fill in the values. .env is never committed (docs/ops-and-deploy.md).

# Staging: the shared development PostgreSQL on the host, database suracdev with its own role.
#   Host=host.docker.internal;Port=5432;Database=suracdev;Username=suracdev;Password=...;GSS Encryption Mode=Disable
# Production: the surac-dev-db container.
#   Host=surac-dev-db;Port=5432;Database=suracdev;Username=suracdev;Password=...
SURACDEV_CONNECTION_STRING=

# Production only (COMPOSE_PROFILES=prod): password of the surac-dev-db role. Must match the connection string.
SURACDEV_DB_PASSWORD=
COMPOSE_PROFILES=

# Where the web container is published. Staging: LAN address of the host (e.g. its IP) and port 8085.
# Production: 127.0.0.1 and the port Caddy proxies to.
SURACDEV_WEB_BIND=127.0.0.1
SURACDEV_WEB_PORT=8085

# Host names the SSR engine accepts in addition to surac.dev / www.surac.dev (comma-separated).
# Staging: the host's LAN and tailnet names and its IP. Production: 127.0.0.1 is enough (Caddy
# forwards the public name in Host).
SURACDEV_ALLOWED_HOSTS=localhost,127.0.0.1

# OpenTelemetry (production only; empty keeps telemetry off). Endpoint of the Seq OTLP ingest over
# the private network and the header carrying its API key, e.g. "X-Seq-ApiKey=...".
SURACDEV_OTLP_ENDPOINT=
SURACDEV_OTLP_HEADERS=
